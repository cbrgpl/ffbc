{
  "name": "admin-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "check:tests:unit": "vitest",
    "build-only": "vite build",
    "mock:api:generate": "orval --config mock/orval.config.ts",
    "mock:init": "msw init ./public --save"
  },
  "dependencies": {
    "@ffbc/shared": "*",
    "@nuxt/ui": "^4.8.0",
    "@pinia/colada": "^1.3.1",
    "@vueuse/core": "^14.3.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0",
    "vue": "3.5.40",
    "vue-router": "^5.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@iconify-json/mdi": "^1.2.3",
    "@pinia/colada-devtools": "^1.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.0.2",
    "msw": "^2.14.6",
    "npm-run-all2": "^8.0.4",
    "orval": "^8.16.0",
    "typescript": "~6.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "vue": "beta",
    "@vue/compiler-core": "beta",
    "@vue/compiler-dom": "beta",
    "@vue/compiler-sfc": "beta",
    "@vue/compiler-ssr": "beta",
    "@vue/compiler-vapor": "beta",
    "@vue/reactivity": "beta",
    "@vue/runtime-core": "beta",
    "@vue/runtime-dom": "beta",
    "@vue/runtime-vapor": "beta",
    "@vue/server-renderer": "beta",
    "@vue/shared": "beta",
    "@vue/compat": "beta"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
