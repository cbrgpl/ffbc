{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "components.auto.d.ts",
    "auto-imports.auto.d.ts",
    "index.ts",
    "libs/**/*.ts",
    "nuxt-ui/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.vue",
    "vitests.setup.ts"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "#build/ui": ["./node_modules/.nuxt-ui/ui/index.ts"],
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"],
      "#imports": ["../../node_modules/@nuxt/ui/dist/runtime/vue/stubs/vue-router"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
