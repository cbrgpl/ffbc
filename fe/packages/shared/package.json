{
  "name": "@ffbc/shared",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuxt-ui": {
      "types": "./dist/nuxt-ui/index.d.ts",
      "import": "./dist/nuxt-ui.js"
    }
  },
  "scripts": {
    "check:types": "vue-tsc --noEmit",
    "check:test:component": "vitest",
    "check:test:component:once": "vitest run --passWithNoTests",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "prepublish": "npm run check:types && npm run check:test:component:once && npm run build"
  },
  "dependencies": {
    "@nuxt/ui": "^4.8.2",
    "@vueuse/core": "^14.1.0",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "vite": "^7.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.5"
  }
}
